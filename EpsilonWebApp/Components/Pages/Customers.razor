@page "/customers"
@rendermode InteractiveServer
@attribute [Authorize]
@using EpsilonWebApp.Models
@using EpsilonWebApp.Services
@inject ICustomerService CustomerService
@inject IJSRuntime JS

<PageTitle>Customers</PageTitle>

<h1>Customers</h1>

<button class="btn btn-primary mb-3" @onclick="AddNew">+ New Customer</button>

@if (result is null)
{
    <p><em>Loading...</em></p>
}
else if (result.Items.Count == 0)
{
    <p>No customers found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Company</th>
                <th>Contact</th>
                <th>City</th>
                <th>Country</th>
                <th>Phone</th>
                <th style="width:150px">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in result.Items)
            {
                <tr>
                    <td>@c.CompanyName</td>
                    <td>@c.ContactName</td>
                    <td>@c.City</td>
                    <td>@c.Country</td>
                    <td>@c.Phone</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(c)">Edit</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(c)">Delete</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex align-items-center gap-3">
        <button class="btn btn-outline-secondary" disabled="@(page <= 1)" @onclick="PrevPage">Previous</button>
        <span>Page @result.Page of @result.TotalPages (@result.TotalCount total)</span>
        <button class="btn btn-outline-secondary" disabled="@(page >= result.TotalPages)" @onclick="NextPage">Next</button>
    </div>
}

@if (showForm)
{
    <CustomerFormDialog Model="editing"
                        Title="@(isNew ? "New Customer" : "Edit Customer")"
                        OnSave="Save"
                        OnCancel="Cancel" />
}

@code {
    private PagedResult<Customer>? result;
    private int page = 1;
    private const int pageSize = 10;
    private bool showForm;
    private bool isNew;
    private Customer editing = new();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => result = await CustomerService.GetPagedAsync(page, pageSize);

    private void AddNew()
    {
        editing = new Customer();
        isNew = true;
        showForm = true;
    }

    private void Edit(Customer c)
    {
        editing = new Customer
        {
            Id = c.Id,
            CompanyName = c.CompanyName,
            ContactName = c.ContactName,
            Address = c.Address,
            City = c.City,
            Region = c.Region,
            PostalCode = c.PostalCode,
            Country = c.Country,
            Phone = c.Phone
        };
        isNew = false;
        showForm = true;
    }

    private async Task Save()
    {
        if (isNew)
            await CustomerService.CreateAsync(editing);
        else
            await CustomerService.UpdateAsync(editing.Id, editing);

        showForm = false;
        await Load();
    }

    private void Cancel() => showForm = false;

    private async Task Delete(Customer c)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"Delete '{c.CompanyName}'?");
        if (!confirmed) return;

        await CustomerService.DeleteAsync(c.Id);

        if (result is not null && result.Items.Count == 1 && page > 1)
            page--;

        await Load();
    }

    private async Task PrevPage()
    {
        if (page <= 1) return;
        page--;
        await Load();
    }

    private async Task NextPage()
    {
        if (result is null || page >= result.TotalPages) return;
        page++;
        await Load();
    }
}
