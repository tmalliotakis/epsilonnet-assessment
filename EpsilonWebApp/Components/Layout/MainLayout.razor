@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 gap-3">
            <AuthorizeView Context="authState">
                <Authorized>
                    <MudText Typo="Typo.body2" Class="d-flex align-center">
                        <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                        @authState.User.Identity?.Name
                    </MudText>
                    <EditForm Model="this" method="post" OnValidSubmit="Logout" FormName="logout-top">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Outlined" Color="Color.Primary"
                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout">Logout</MudButton>
                    </EditForm>
                </Authorized>
                <NotAuthorized>
                    <MudButton Href="login" Variant="Variant.Text" Color="Color.Primary"
                               Size="Size.Small" StartIcon="@Icons.Material.Filled.Login">Login</MudButton>
                </NotAuthorized>
            </AuthorizeView>
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private async Task Logout()
    {
        await HttpContextAccessor.HttpContext!.SignOutAsync(
            CookieAuthenticationDefaults.AuthenticationScheme);

        Nav.NavigateTo("login");
    }
}
