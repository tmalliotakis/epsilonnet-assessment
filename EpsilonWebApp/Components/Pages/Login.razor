@page "/login"
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using EpsilonWebApp.Services
@inject AuthService Auth
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-5">
        <h1>Login</h1>

        @if (errorMessage is not null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label class="form-label">Username</label>
                <InputText class="form-control" @bind-Value="Input.Username" />
                <ValidationMessage For="() => Input.Username" />
            </div>
            <div class="mb-3">
                <label class="form-label">Password</label>
                <InputText type="password" class="form-control" @bind-Value="Input.Password" />
                <ValidationMessage For="() => Input.Password" />
            </div>
            <button type="submit" class="btn btn-primary">Log in</button>
        </EditForm>
    </div>
</div>

@code {
    [SupplyParameterFromForm] private LoginInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? errorMessage;

    private async Task LoginUser()
    {
        if (!Auth.ValidateCredentials(Input.Username!, Input.Password!))
        {
            errorMessage = "Invalid username or password.";
            return;
        }

        var claims = new List<Claim> { new(ClaimTypes.Name, Input.Username!) };
        var identity = new ClaimsIdentity(claims, CookieAuthenticationDefaults.AuthenticationScheme);
        var principal = new ClaimsPrincipal(identity);

        await HttpContextAccessor.HttpContext!.SignInAsync(
            CookieAuthenticationDefaults.AuthenticationScheme, principal);

        Nav.NavigateTo(string.IsNullOrEmpty(ReturnUrl) ? "customers" : ReturnUrl);
    }

    private sealed class LoginInput
    {
        [Required]
        public string? Username { get; set; }

        [Required]
        public string? Password { get; set; }
    }
}
