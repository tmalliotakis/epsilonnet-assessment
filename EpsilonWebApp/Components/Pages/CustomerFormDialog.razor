@using EpsilonWebApp.Models

<MudOverlay Visible="true" DarkBackground="true" />

<div style="position:fixed; inset:0; display:flex; align-items:center; justify-content:center; z-index:1400;">
    <MudPaper Elevation="8" Class="pa-6" Style="width:520px; max-width:95vw; max-height:90vh; overflow:auto;">
        <EditForm Model="Model" OnValidSubmit="Submit">
            <DataAnnotationsValidator />
            <MudText Typo="Typo.h6" Class="mb-4">@Title</MudText>

            <MudTextField @bind-Value="Model.CompanyName" Label="Company Name"
                          For="@(() => Model.CompanyName)" Class="mb-2" />
            <MudTextField @bind-Value="Model.ContactName" Label="Contact Name"
                          For="@(() => Model.ContactName)" Class="mb-2" />
            <MudTextField @bind-Value="Model.Address" Label="Address"
                          For="@(() => Model.Address)" Class="mb-2" />

            <div class="d-flex gap-3">
                <MudTextField @bind-Value="Model.City" Label="City"
                              For="@(() => Model.City)" Class="mb-2" />
                <MudTextField @bind-Value="Model.Region" Label="Region"
                              For="@(() => Model.Region)" Class="mb-2" />
            </div>
            <div class="d-flex gap-3">
                <MudTextField @bind-Value="Model.PostalCode" Label="Postal Code"
                              For="@(() => Model.PostalCode)" Class="mb-2" />
                <MudTextField @bind-Value="Model.Country" Label="Country"
                              For="@(() => Model.Country)" Class="mb-2" />
            </div>
            <MudTextField @bind-Value="Model.Phone" Label="Phone"
                          For="@(() => Model.Phone)" Class="mb-4" />

            <div class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Text" OnClick="OnCancel">Cancel</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled"
                           Color="Color.Primary">Save</MudButton>
            </div>
        </EditForm>
    </MudPaper>
</div>

@code {
    [Parameter] public Customer Model { get; set; } = new();
    [Parameter] public string Title { get; set; } = "Customer";
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task Submit() => await OnSave.InvokeAsync();
}
